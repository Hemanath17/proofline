# Copy to .env.local and fill in. Never commit the real values.

# Neon Postgres, SQLAlchemy + psycopg 3 format, SSL required
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Vercel Blob, for attachments
BLOB_READ_WRITE_TOKEN=

# Simulation target for /simulate live runs
SIM_BASE_URL=

# Step 10 only
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=